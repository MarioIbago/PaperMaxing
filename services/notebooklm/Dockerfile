FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NOTEBOOKLM_SERVER_HOST=0.0.0.0 NOTEBOOKLM_SERVER_PORT=8100 NOTEBOOKLM_SERVER_ALLOW_EXTERNAL_BIND=1 NOTEBOOKLM_HOME=/data/notebooklm
RUN pip install --no-cache-dir "notebooklm-py[server,headless]==0.8.1"
EXPOSE 8100
CMD ["notebooklm-server"]
