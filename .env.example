NEXT_PUBLIC_APP_NAME=PaperMaxing
NEXT_PUBLIC_STORAGE_MODE=browser
NEXT_PUBLIC_DEFAULT_PROVIDER=openrouter
NEXT_PUBLIC_DEFAULT_MODEL=

# Server-side provider keys. Leave blank to require BYOK.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# If true, clients may send their own provider key per request.
ALLOW_BYOK=true

# Optional defaults; leave empty to require an explicit model.
OPENROUTER_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
OPENAI_COMPATIBLE_MODEL=

# Safety limits for a stateless demo deployment.
MAX_PROMPT_CHARS=120000
