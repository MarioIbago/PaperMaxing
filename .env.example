# PaperMaxing web
PAPERMAXING_MODE=local
NEXT_PUBLIC_APP_NAME=PaperMaxing
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default UI choices. Users can override provider/model/grounding in Settings;
# their selection is saved in browser localStorage.
RESEARCH_ENGINE=direct
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/auto

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Ollama / local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Generic OpenAI-compatible endpoint. Include /v1 in the base URL when your server expects it.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=model

# Optional NotebookLM gateway (server-side only).
# Never expose these with NEXT_PUBLIC_.
NOTEBOOKLM_API_URL=http://localhost:8100
NOTEBOOKLM_SERVER_TOKEN=replace-with-a-long-random-secret
NOTEBOOKLM_PROFILE=papermaxing
NOTEBOOKLM_HOME_HOST=./.papermaxing/notebooklm

# Optional deterministic parser / database services
PARSER_API_URL=http://localhost:8000
GROBID_URL=http://localhost:8070
DATABASE_URL=postgresql://papermaxing:papermaxing@localhost:5432/papermaxing
POSTGRES_DB=papermaxing
POSTGRES_USER=papermaxing
POSTGRES_PASSWORD=papermaxing

# Grounding policy
CITATION_STRICTNESS=strict
ALLOW_UNGROUNDED_INFERENCE=false

# Optional academic metadata
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=
