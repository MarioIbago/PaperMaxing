# Core
PAPERMAXING_MODE=local
NEXT_PUBLIC_APP_NAME=PaperMaxing
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://papermaxing:papermaxing@localhost:5432/papermaxing
POSTGRES_DB=papermaxing
POSTGRES_USER=papermaxing
POSTGRES_PASSWORD=papermaxing

# Parser
PARSER_API_URL=http://localhost:8000
GROBID_URL=http://localhost:8070

# Research engine: notebooklm | local | direct
RESEARCH_ENGINE=notebooklm

# LLM provider: openrouter | openai | anthropic | google | ollama | openai-compatible
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b

# NotebookLM (server-side only)
NOTEBOOKLM_API_URL=http://localhost:8100
NOTEBOOKLM_SERVER_TOKEN=change-me-with-a-long-random-secret
NOTEBOOKLM_PROFILE=papermaxing
NOTEBOOKLM_HOME_HOST=./.papermaxing/notebooklm

# Provider credentials (fill only what you use)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Grounding
CITATION_STRICTNESS=strict
ALLOW_UNGROUNDED_INFERENCE=false

# Optional academic metadata
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=
